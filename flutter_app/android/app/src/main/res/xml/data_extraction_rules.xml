<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+ (android:dataExtractionRules).
  Disables cloud backup AND device-to-device transfer for all app data.
  Health screening data must never leave the device via backup transport.

  See: https://developer.android.com/guide/topics/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup disableIfDbSizeExceeded="false">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
