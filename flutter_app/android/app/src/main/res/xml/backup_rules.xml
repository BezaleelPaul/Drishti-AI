<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for API < 31 (android:fullBackupContent).
  Empty set: no files, databases, or shared prefs are backed up.
  Must stay in sync with data_extraction_rules.xml.
-->
<full-backup-content>
    <!-- Exclude everything explicitly (defence in depth). -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
